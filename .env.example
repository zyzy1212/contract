POSTGRES_DB=contract_review
POSTGRES_USER=contract
POSTGRES_PASSWORD=contract
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
DATABASE_URL=postgresql+asyncpg://contract:contract@localhost:5432/contract_review
REDIS_URL=redis://localhost:6379/0
OBJECT_STORE_ENDPOINT=http://localhost:9000
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 支持逗号分隔多个 key，例如 sk-a, sk-b；自动轮询并在限流/超时后切换
DEEPSEEK_API_KEY=sk-REPLACE_WITH_YOUR_KEY
DEEPSEEK_GENERATION_MODEL=deepseek-v4-flash
DEEPSEEK_REVIEW_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_RETRIES=3
DEEPSEEK_RETRY_BASE_DELAY_SECONDS=1.0

# Embedding
EMBEDDING_BATCH_SIZE=128
EMBEDDING_PRECISION=auto

# Review
REVIEW_CLAUSE_CONCURRENCY=4
REVIEW_QUERY_EXPANSION_ENABLED=true
REVIEW_QUERY_EXPANSION_MAX_QUERIES=3
REVIEW_QUERY_EXPANSION_MIN_CHARACTERS=30
REVIEW_RETRIEVAL_MAX_ROUNDS=3
